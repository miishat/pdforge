{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDForge",
  "version": "0.2.2",
  "identifier": "com.miishat.pdforge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PDForge",
        "width": 1280,
        "height": 860,
        "minWidth": 640,
        "minHeight": 480,
        "decorations": false,
        "shadow": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost https://cdn.jsdelivr.net https://api.openai.com https://api.deepseek.com https://generativelanguage.googleapis.com https://api.mistral.ai https://api.groq.com https://openrouter.ai http://localhost:* http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "miishat",
    "shortDescription": "PDF reader and editor",
    "longDescription": "PDForge is a fast, private, offline PDF reader and editor.",
    "license": "AGPL-3.0-or-later",
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "mimeType": "application/pdf",
        "description": "PDF document",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU1NkIwRkU4QTk1Q0E2Q0QKUldUTnBseXA2QTlyVlpWKzRVcTk3YVNhWkdCdDJ1cExOcU8xbnE3UU4yM25QMDdFQURrd1pDeTQK",
      "endpoints": [
        "https://github.com/miishat/pdforge/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
